---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import MenuCategorias from "../components/MenuCategorias.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SobreTuKDrama from "../components/SobreTuKDrama.astro";
---

<Layout>
    <Header />

    <main class="flex flex-col lg:flex-row items-start gap-6 lg:gap-10 p-4 lg:p-6">
        <MenuCategorias />
        <Hero />
    </main>

    <div id="sobre-tu-kdrama-contenedor" class="hidden">
        <SobreTuKDrama />
    </div>
</Layout>

<script>
    const botonSobre = document.getElementById("boton-sobre");
    const botonCerrarSobre = document.getElementById("boton-cerrar-sobre");
    const contenedorSobre = document.getElementById(
        "sobre-tu-kdrama-contenedor"
    );

    botonSobre?.addEventListener("click", () => {
        contenedorSobre?.classList.remove("hidden");
    });

    botonCerrarSobre?.addEventListener("click", () => {
        contenedorSobre?.classList.add("hidden");
    });
</script>
