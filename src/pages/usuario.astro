---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout>
    <Header />

    <main class="min-h-screen bg-[#F7F3ED] px-6 py-12">
        <div class="max-w-3xl mx-auto">
            <h1
                class="font-['Cormorant_Garamond'] text-4xl lg:text-5xl font-semibold mb-10"
            >
                Mi cuenta
            </h1>

            <section class="border border-[#B58A2A] p-8 md:p-10">
                <h2
                    class="font-['Cormorant_Garamond'] text-3xl font-semibold mb-4"
                >
                    Accede a Tu K-Drama
                </h2>

                <p class="font-['Manrope']">
                    Identifícate con tu cuenta de Google para acceder a tu perfil.
                </p>

                <button
                    id="login-google"
                    type="button"
                    class="mt-6 border border-[#B58A2A] px-6 py-3 font-['Manrope'] font-semibold hover:bg-[#B58A2A] hover:text-white transition-colors"
                >
                    Continuar con Google
                </button>
            </section>
        </div>
    </main>
</Layout>

<script>
    import { supabase } from "../lib/supabase";

    const botonGoogle = document.getElementById("login-google");

    botonGoogle?.addEventListener("click", async () => {
        // Conservar el origen de navegación (lista blanca) a través del OAuth.
        const volver = new URLSearchParams(window.location.search).get("volver");
        const destino = volver === "carrito" ? "/perfil?volver=carrito" : "/perfil";

        const { error } = await supabase.auth.signInWithOAuth({
            provider: "google",
            options: {
                redirectTo: `${window.location.origin}${destino}`,
            },
        });

        if (error) {
            console.error("Error al iniciar sesión con Google:", error.message);
        }
    });
</script>
