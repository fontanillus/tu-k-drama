---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { getProductoPorId } from "../lib/productos";

const productoParam = Astro.url.searchParams.get("id");
const productoId = Number(productoParam);

if (!productoParam || Number.isNaN(productoId)) {
    return Astro.redirect("/");
}

const producto = await getProductoPorId(productoId);
---

<Layout>
    <Header />

    <main class="min-h-screen bg-[#F7F3ED] px-6 py-12">
        <div class="max-w-7xl mx-auto">
            {
                producto && (
                    <div class="flex flex-wrap gap-4 mb-8">
                        <a
                            href="/"
                            class="border border-[#B58A2A] px-5 py-3 font-['Manrope'] transition-all duration-300 hover:bg-[#B58A2A] hover:text-white hover:shadow-md"
                        >
                            ← Volver al inicio
                        </a>

                        <a
                            href={`/productos?categoria=${producto.fk_categoria}`}
                            class="border border-[#B58A2A] px-5 py-3 font-['Manrope'] transition-all duration-300 hover:bg-[#B58A2A] hover:text-white hover:shadow-md"
                        >
                            ← Volver a la categoría
                        </a>
                    </div>
                )
            }

            {
                producto && (
                    <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

                        <!-- IMAGEN -->
                        <div>
                            <img
                                src={producto.url_imagen ?? ""}
                                alt={producto.nombre_producto}
                                class="w-full h-112.5 object-contain border border-[#B58A2A] bg-white"
                            />
                        </div>

                        <!-- INFORMACIÓN -->
                        <div class="flex flex-col gap-6">

                            <h1 class="font-['Cormorant_Garamond'] text-4xl lg:text-5xl font-semibold">
                                {producto.nombre_producto}
                            </h1>

                            <p class="font-['Manrope'] text-lg leading-relaxed">
                                {producto.descripcion_producto}
                            </p>

                            <p class="font-['Manrope'] text-2xl font-semibold text-[#B58A2A]">
                                {Number(producto.precio).toFixed(2)} €
                            </p>

                            <p class="font-['Manrope'] text-sm">
                                Precios con IVA incluido.
                            </p>

                            <p class="font-['Manrope']">
                                Stock disponible: {producto.stock}
                                <span
                                    id="indicador-disponibilidad"
                                    class="hidden ml-2 text-sm font-semibold text-[#B58A2A]"
                                ></span>
                            </p>

                            <div class="flex items-center gap-3">
                                <span class="font-['Manrope'] font-semibold">Cantidad:</span>

                                <div class="flex items-center border border-[#B58A2A]">
                                    <button
                                        id="restar-cantidad"
                                        type="button"
                                        class="px-4 py-2 font-['Manrope'] text-xl hover:bg-[#E5D1CB]"
                                    >
                                        −
                                    </button>

                                    <span
                                        id="cantidad"
                                        class="px-5 py-2 font-['Manrope'] font-semibold"
                                    >
                                        1
                                    </span>

                                    <button
                                        id="sumar-cantidad"
                                        type="button"
                                        class="px-4 py-2 font-['Manrope'] text-xl hover:bg-[#E5D1CB]"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <p
                                id="mensaje-stock"
                                class="hidden font-['Manrope'] text-sm font-semibold text-[#B08D57]"
                            >
                                Has alcanzado el stock disponible ({producto?.stock} unidades).
                            </p>

                            <button
                                id="btn-carrito"
                                data-id={producto.pk_producto}
                                data-nombre={producto.nombre_producto}
                                data-precio={producto.precio}
                                data-stock={producto.stock}
                                class="w-fit bg-[#1A1A1A] text-white font-['Manrope'] px-8 py-4 hover:bg-[#B58A2A] transition-colors"
                            >
                                Añadir al carrito
                            </button>

                        </div>

                    </section>
                )
            }
        </div>
    </main>
    <script define:vars={{ stockProducto: producto?.stock ?? null }} is:inline>
        (() => {
            const indicador = document.getElementById(
                "indicador-disponibilidad"
            );

            if (!indicador) {
                return;
            }

            if (
                typeof stockProducto !== "number" ||
                !Number.isFinite(stockProducto) ||
                stockProducto < 0
            ) {
                console.error("Stock inválido para el indicador de disponibilidad.");
                return;
            }

            indicador.textContent =
                stockProducto > 0 ? "En stock" : "Agotado";
            indicador.classList.remove("hidden");
        })();
    </script>
</Layout>
<script>
    import { agregarAlCarrito, leerCarrito } from "../lib/carrito";

    const boton = document.querySelector<HTMLButtonElement>("#btn-carrito");

    const botonRestar =
        document.querySelector<HTMLButtonElement>("#restar-cantidad");

    const botonSumar =
        document.querySelector<HTMLButtonElement>("#sumar-cantidad");

    const cantidadElemento =
        document.querySelector<HTMLElement>("#cantidad");

    let cantidad = 1;
    const stock = Number(boton?.dataset.stock ?? 0);

    const mensajeStock =
        document.querySelector<HTMLElement>("#mensaje-stock");

    function actualizarMensajeStock() {
        if (mensajeStock) {
            mensajeStock.classList.toggle("hidden", cantidad < stock);
        }
    }

    actualizarMensajeStock();

    botonSumar?.addEventListener("click", () => {
        if (cantidad < stock) {
            cantidad++;
            if (cantidadElemento) {
                cantidadElemento.textContent = String(cantidad);
            }
            actualizarMensajeStock();
        }
    });

    botonRestar?.addEventListener("click", () => {
        if (cantidad > 1) {
            cantidad--;
            if (cantidadElemento) {
                cantidadElemento.textContent = String(cantidad);
            }
            actualizarMensajeStock();
        }
    });

    boton?.addEventListener("click", () => {
        const id = boton.dataset.id;
        const nombre = boton.dataset.nombre;
        const precio = boton.dataset.precio;

        if (!id || !nombre || !precio) {
            return;
        }

        const resultado = agregarAlCarrito(
            { id, nombre, precio: Number(precio), stock },
            cantidad
        );

        if (!resultado.ok) {
            if (mensajeStock) {
                mensajeStock.textContent =
                    resultado.motivo === "sin-stock"
                        ? "Producto sin stock disponible."
                        : `Solo hay ${stock} unidades disponibles. Ya tienes ${resultado.enCarrito} en el carrito.`;
                mensajeStock.classList.remove("hidden");
            }
            return;
        }

        console.log(leerCarrito());

        // Reiniciar el selector después de añadir al carrito
        cantidad = 1;

        if (cantidadElemento) {
            cantidadElemento.textContent = String(cantidad);
        }

        actualizarMensajeStock();
    });
</script>
